# Copy this file to `.env` (no extension change, just remove `.example`) and
# fill in the values. `.env` is git-ignored — never check it in.

# Claude Sonnet 4.6 — used by 16_injury_fetcher.py to extract structured injury
# data from news headlines. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telegram bot (only needed when you actually run match_bot.py for real)
FIFA_BOT_TOKEN=
FIFA_BOT_CHAT_ID=

# OPTIONAL: API-Football (RapidAPI) — backup lineup source if FIFA API is down.
# Free tier 100 calls/day. https://www.api-football.com/
RAPIDAPI_KEY=

# OPTIONAL: Override the API base for the bot if running uvicorn on a different port
FIFA_API_BASE=http://127.0.0.1:8001
